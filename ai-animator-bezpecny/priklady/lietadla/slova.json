 "vety": [
  {
   "text": "Prečo lietadlá na mape nelietajú rovno?",
   "s": 0.0,
   "e": 2.24
  },
  {
   "text": "Keď letíš z Viedne do Los Angeles, lietadlo zabočí až nad Grónsko.",
   "s": 2.5,
   "e": 6.82
  },
  {
   "text": "Vyzerá to ako obchádzka.",
   "s": 7.44,
   "e": 8.74
  },
  {
   "text": "Lenže Zem nie je placka.",
   "s": 9.14,
   "e": 10.78
  },
  {
   "text": "Je to guľa.",
   "s": 11.04,
   "e": 11.86
  },
  {
   "text": "A na guli je najkratšia cesta oblúk.",
   "s": 12.08,
   "e": 14.38
  },
  {
   "text": "Keď ho prenesieš na plochú mapu, ohne sa.",
   "s": 14.76,
   "e": 17.46
  },
  {
   "text": "Rovná čiara na mape je v skutočnosti o tisíc päťsto kilometrov dlhšia.",
   "s": 18.06,
   "e": 21.9
  },
  {
   "text": "Takže pilot nezatáča.",
   "s": 22.2,
   "e": 23.76
  },
  {
   "text": "Letí najkratšou cestou.",
   "s": 24.08,
   "e": 25.54
  },
  {
   "text": "Klame tvoja mapa.",
   "s": 26.06,
   "e": 26.98
  }
 ]
